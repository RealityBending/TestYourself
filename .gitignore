# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# `docs/` is the documentation page about the app, and under it the deck it
# grew out of — hand-written files, nothing built —
# and is kept. (This line used to ignore the whole folder, from the R-package
# template these rules came out of, where it meant a generated pkgdown site.
# There has never been one here.)

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Reference PDFs behind the questionnaire ideas list - not part of the app
literature/

# Synthetic runs: regenerable work files and generated data, not part of the app
data/synthetic/work/
data/synthetic/out/
__pycache__/

# The Big Kink Survey's public file (52 MB, fetched by data/norms/norms_bks.R
# from its Zenodo record) and what the script writes beside it.
data/norms/bks/

# The answers themselves, pulled off Zenodo by data/collected/download.py, and
# the tables preprocess.R makes of them. Real participant data: it lives on this
# machine and in the deposit, never here.
data/collected/raw/
data/collected/clean/
# ...and the overview rendered out of them: aggregates, but of a handful of people.
data/collected/overview.html
data/collected/overview_files/

# The old pictures level 1's two figures are cut from: public domain, sixteen
# megabytes between them, and fetched again from Wikimedia Commons by
# assets/theories/source/cut.py whenever one is missing. What it cuts them into
# is committed.
assets/theories/source/*.jpg

# The MNI152 template the MINT's brain is cut from: fourteen megabytes, fetched
# again from TemplateFlow by assets/mint/source/cut.py whenever it is missing.
# What it cuts, assets/mint/brain.jpg, is committed.
assets/mint/source/*.nii.gz

# The Hyborian Age's hero pictures as generated, four to five megabytes each.
# Nothing fetches them again, so they live in Dropbox alone; what
# assets/hyborian/source/cut.py cuts them into is committed.
assets/hyborian/source/*.jpg
